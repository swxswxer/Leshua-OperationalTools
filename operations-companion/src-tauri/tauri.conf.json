{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "运营工具快捷菜单",
  "version": "0.1.0",
  "identifier": "com.leshuazf.operations-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "运营工具快捷菜单",
        "width": 230,
        "height": 160,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
