{
  "manifest_version": 3,
  "name": "运营工具",
  "version": "1.0.2",
  "key": "",
  "description": "运营后台联合收单、收银通子商户号重置及辅助工具。",
  "permissions": [
    "storage",
    "clipboardWrite",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://om.leshuazf.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "host_permissions": ["https://om.leshuazf.com/*"]
}
