{
  "manifest_version": 3,
  "name": "运营工具",
  "version": "1.0.10",
  "minimum_chrome_version": "120",
  "key": "",
  "description": "运营后台联合收单、收银通子商户号重置及辅助工具。",
  "permissions": [
    "sidePanel",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "打开运营工具侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://om.leshuazf.com/*"
  ]
}
